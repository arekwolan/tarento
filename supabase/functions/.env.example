# Sekrety funkcji brzegowych dla lokalnego `supabase start`.
#
# Skopiuj do supabase/functions/.env. Ten plik NIE trafia do aplikacji
# mobilnej — jest czytany wyłącznie przez runtime Deno po stronie serwera.
#
# Na zdalnym projekcie ustaw je przez:
#   supabase secrets set GEMINI_API_KEY=...
#   supabase secrets set GEMINI_MODEL=gemini-3.5-flash-lite

GEMINI_API_KEY=
# Nazwa modelu w zmiennej, bo Google wygasza modele co kilka miesięcy
# i podmiana nie powinna wymagać wydania nowej wersji aplikacji.
GEMINI_MODEL=gemini-3.5-flash-lite
