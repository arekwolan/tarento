# Podgląd zmiennych środowiskowych aplikacji.
#
# UWAGA: do pracy lokalnej NIE trzeba niczego z tego pliku kopiować.
# `npm run dev` sam odczytuje adres i klucz z uruchomionej bazy i zapisuje
# je do .env.local. Ten plik jest tylko dokumentacją tego, co aplikacja czyta.
#
# Obie zmienne są publiczne z założenia: trafiają do bundla aplikacji i każdy
# może je z niego wyciągnąć. To jest w porządku wyłącznie dlatego, że dostęp
# do danych pilnuje RLS po stronie Postgresa.
#
# NIE dopisuj tu klucza service_role ani klucza Gemini API. Sekrety trzymamy
# w sekretach Supabase Edge Functions (CLAUDE.md, reguła krytyczna 1).

# Te dwie wpisuje automatycznie `npm run dev` do pliku .env.local.
# Nie trzymaj ich w .env — Expo czyta .env.local jako ważniejszy, więc
# wartości z .env byłyby po cichu ignorowane.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Na fizycznym urządzeniu 127.0.0.1 wskazuje na telefon, nie na Twój komputer.
# `npm run dev` wykrywa to sam i wstawia adres LAN maszyny (np.
# http://192.168.1.20:55321). Ręcznie można go wymusić: npm run dev -- --host=IP

# --- Telemetria (opcjonalna) -------------------------------------------------
#
# Oba klucze są kluczami TYLKO DO ZAPISU: pozwalają wysłać zdarzenie i nic
# więcej — nie da się nimi odczytać żadnych danych. Dlatego mogą stać
# w EXPO_PUBLIC_*, mimo reguły krytycznej 1 (patrz wyjątek w CLAUDE.md §6).
#
# Puste = dane narzędzie się nie uruchamia. Build deweloperski zostaw pusty,
# żeby nie zaśmiecać produkcyjnego projektu.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- EAS ---------------------------------------------------------------------
#
# Ustawiane przez `eas init`; w CI wstrzykiwane jako sekret.
EAS_PROJECT_ID=

# --- Czego tu NIE ma ---------------------------------------------------------
#
# Klucz Gemini nie jest zmienną aplikacji i nigdy nie trafia do bundla.
# Żyje wyłącznie w sekretach funkcji brzegowych:
#
#   supabase secrets set GEMINI_API_KEY=...
#   supabase secrets set GEMINI_MODEL=gemini-3.5-flash-lite
#
# Lokalnie te same wartości wpisz do supabase/functions/.env (plik jest
# ignorowany przez gita).
